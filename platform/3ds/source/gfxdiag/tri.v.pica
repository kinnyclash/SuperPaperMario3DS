; Minimal shader, same structure as devkitPro's simple_tri example: position in, projection
; uniform, solid white out. Inputs: v0 = position (xyz).
.fvec projection[4]

.constf myconst(0.0, 1.0, -1.0, 0.1)
.alias ones myconst.yyyy

.out outpos position
.out outclr color

.alias inpos v0

.proc main
  mov r0.xyz, inpos
  mov r0.w, ones
  dp4 outpos.x, projection[0], r0
  dp4 outpos.y, projection[1], r0
  dp4 outpos.z, projection[2], r0
  dp4 outpos.w, projection[3], r0
  mov outclr, ones
  end
.end
